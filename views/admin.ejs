<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus — Админ-панель</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 font-sans text-slate-900 antialiased flex h-screen overflow-hidden">

    <!-- Боковая панель (Sidebar) -->
    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col justify-between hidden md:flex">
        <div>
            <!-- Логотип -->
            <div class="h-16 flex items-center px-6 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-lg shadow-md shadow-blue-500/30">
                        N
                    </div>
                    <span class="font-bold text-lg tracking-tight text-slate-900">Nexus</span>
                </div>
            </div>

            <!-- Навигация -->
            <nav class="p-4 space-y-1">
                <a href="/applications" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-50 font-medium text-sm transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                    Каталог программ
                </a>
                <a href="/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-50 font-medium text-sm transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                    Мои заявки
                </a>
                <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-blue-50 text-blue-600 font-medium text-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                    Админ-панель
                </a>
            </nav>
        </div>

        <!-- Нижний блок -->
        <div class="p-4 border-t border-slate-100">
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/60">
                <p class="text-xs font-semibold text-slate-800">Нужна помощь?</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Панель управления системой.</p>
            </div>
            <div class="flex items-center gap-2 mt-3 px-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-slate-500 font-medium">Режим администратора</span>
            </div>
        </div>
    </aside>

    <!-- Основной контент -->
    <div class="flex-1 flex flex-col overflow-hidden">
        
        <!-- Шапка -->
        <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 z-10">
            <div class="w-96">
                <input type="text" placeholder="Поиск по заявкам..." class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all">
            </div>
            <div class="flex items-center gap-4">
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 bg-blue-100 text-blue-700 font-semibold rounded-full flex items-center justify-center text-sm">
                            <%= user.email.substring(0, 2).toUpperCase() %>
                        </div>
                        <div class="text-left hidden sm:block">
                            <p class="text-sm font-semibold text-slate-800"><%= user.email %></p>
                            <p class="text-xs text-slate-500">Администратор</p>
                        </div>
                    </div>
                    <a href="/logout" class="flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-red-600 border border-slate-200 rounded-lg hover:border-red-200 transition-colors">
                        Выйти
                    </a>
                <% } %>
            </div>
        </header>

        <!-- Рабочая область -->
        <main class="flex-1 overflow-y-auto p-8">
            <div class="max-w-7xl mx-auto space-y-6">
                
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Панель администратора</h1>
                    <p class="text-sm text-slate-500">Управление всеми поданными заявками абитуриентов и изменение их статусов.</p>
                </div>

                <!-- Таблица управления заявками -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4">Все заявки в системе</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead>
                                <tr class="border-b border-slate-100 text-slate-400 uppercase text-[11px] tracking-wider">
                                    <th class="py-3 px-4 font-semibold">ID Заявки</th>
                                    <th class="py-3 px-4 font-semibold">Абитуриент</th>
                                    <th class="py-3 px-4 font-semibold">Программа</th>
                                    <th class="py-3 px-4 font-semibold">Дата</th>
                                    <th class="py-3 px-4 font-semibold">Текущий статус</th>
                                    <th class="py-3 px-4 font-semibold text-right">Действия</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-slate-700">
                                <% if (typeof applications !== 'undefined' && applications.length > 0) { %>
                                    <% applications.forEach(app => { %>
                                        <tr>
                                            <td class="py-3.5 px-4 font-medium text-slate-900">#<%= app.id.substring(0, 8) %>...</td>
                                            <td class="py-3.5 px-4 text-slate-600"><%= app.profiles ? app.profiles.email : 'Не указан' %></td>
                                            <td class="py-3.5 px-4 font-medium text-slate-900"><%= app.programs ? app.programs.title : 'Не указана' %></td>
                                            <td class="py-3.5 px-4 text-slate-500"><%= new Date(app.created_at).toLocaleDateString('ru-RU') %></td>
                                            <td class="py-3.5 px-4">
                                                <% if (app.status === 'Одобрено') { %>
                                                    <span class="px-2.5 py-1 text-xs font-medium bg-emerald-50 text-emerald-600 rounded-full">● Одобрено</span>
                                                <% } else if (app.status === 'Отклонено') { %>
                                                    <span class="px-2.5 py-1 text-xs font-medium bg-red-50 text-red-600 rounded-full">● Отклонено</span>
                                                <% } else { %>
                                                    <span class="px-2.5 py-1 text-xs font-medium bg-amber-50 text-amber-600 rounded-full">● На рассмотрении</span>
                                                <% } %>
                                            </td>
                                            <td class="py-3.5 px-4 text-right">
                                                <div class="flex items-center justify-end gap-2">
                                                    <!-- Кнопка одобрения -->
                                                    <form action="/admin/applications/<%= app.id %>/status" method="POST">
                                                        <input type="hidden" name="status" value="Одобрено">
                                                        <button type="submit" class="px-3 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-medium text-xs rounded-lg transition-colors">
                                                            Одобрить
                                                        </button>
                                                    </form>
                                                    <!-- Кнопка отклонения -->
                                                    <form action="/admin/applications/<%= app.id %>/status" method="POST">
                                                        <input type="hidden" name="status" value="Отклонено">
                                                        <button type="submit" class="px-3 py-1 bg-red-50 hover:bg-red-100 text-red-700 font-medium text-xs rounded-lg transition-colors">
                                                            Отклонить
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="py-8 text-center text-slate-400">В системе пока нет заявок для проверки</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

</body>
</html>