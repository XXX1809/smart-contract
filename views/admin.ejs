<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Панель администратора</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Панель администратора — Заявки абитуриентов</h2>
        <div>
            <a href="/applications" class="btn btn-outline-primary btn-sm">На сайт</a>
            <a href="/logout" class="btn btn-outline-danger btn-sm">Выйти</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID заявки</th>
                        <th>Абитуриент (Email)</th>
                        <th>Образовательная программа</th>
                        <th>Дата подачи</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (applications && applications.length > 0) { %>
                        <% applications.forEach(app => { %>
                            <tr>
                                <td class="small text-muted">#<%= app.id %></td>
                                <td><strong><%= app.profiles ? app.profiles.email : 'Неизвестен' %></strong></td>
                                <td><%= app.programs ? app.programs.title : 'Удалена' %></td>
                                <td><%= new Date(app.created_at).toLocaleString() %></td>
                                <td>
                                    <% if (app.status === 'Одобрено') { %>
                                        <span class="badge bg-success">Одобрено</span>
                                    <% } else if (app.status === 'Отклонено') { %>
                                        <span class="badge bg-danger">Отклонено</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">На рассмотрении</span>
                                    <% } %>
                                </td>
                                <td>
                                    <form action="/admin/applications/<%= app.id %>/status" method="POST" class="d-inline">
                                        <input type="hidden" name="status" value="Одобрено">
                                        <button type="submit" class="btn btn-success btn-sm">Одобрить</button>
                                    </form>
                                    <form action="/admin/applications/<%= app.id %>/status" method="POST" class="d-inline">
                                        <input type="hidden" name="status" value="Отклонено">
                                        <button type="submit" class="btn btn-danger btn-sm">Отклонить</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Заявок пока нет.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>